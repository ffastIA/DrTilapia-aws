# Copie para `.env` neste mesmo diretório, na EC2 (nunca commite o `.env`
# real — só serve para o `docker compose -f docker-compose.prod.yml`
# interpolar as variáveis abaixo, lidas automaticamente por estar num
# arquivo `.env` ao lado do compose).

ECR_REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com
ECR_REPO_BACKEND=<ECR_REPO_BACKEND>
ECR_REPO_FRONTEND=<ECR_REPO_FRONTEND>

# Tag publicada por deploy/build-and-push.ps1 (SHA curto do commit) — nunca
# "latest", para saber exatamente qual commit está rodando na instância.
IMAGE_TAG=<SHA_CURTO_DO_COMMIT>

ENVIRONMENT=production
