# Copie este arquivo para frontend/.env.local e preencha com os valores reais.
# Nunca commite frontend/.env.local (já está no .gitignore).

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Dr. Tiláp-IA

# URL e chave anon (pública, de baixo privilégio) do projeto Supabase.
# Usadas pelo middleware (frontend/middleware.ts) para validar o papel do
# usuário em /main/admin diretamente contra a API REST do Supabase.
# NUNCA coloque a chave service_role aqui — é a mesma chave anon já usada
# pelo backend (SUPABASE_KEY em backend/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
