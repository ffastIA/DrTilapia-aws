# O contexto de build de ambos os Dockerfiles (backend/backend.Dockerfile,
# frontend.Dockerfile) é a raiz do repositório — este é o único .dockerignore
# efetivo para os dois builds.

.git/
.idea/
.claude/
.codegraph/
.pytest_cache/
openspec/

# Backend
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.env
backend/.env.*
!backend/.env.example
# CA bundle de proxy corporativo (Windows) — nunca deve entrar na imagem via
# COPY; se precisar dele no build, use `docker build --secret id=ca_bundle,...`
# (ver backend.Dockerfile). Runtime local usa bind mount (docker-compose.yml).
backend/ca-bundle-windows.pem
backend/*.pem.bak
backend/tests/
backend/evaluation/runs/
backend/docs/*.pdf
backend/uploads/
backend/uploaded_files/
backend/temp_uploads/
backend/*.log

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/npm-debug.log*

# Raiz
.env
.env.*
!.env.example
*.log
