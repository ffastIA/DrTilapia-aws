# Copie este arquivo para backend/.env e preencha com os valores reais.
# Nunca commite backend/.env (já está no .gitignore).

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# URL do frontend, usada para montar os links de confirmação de email e
# redefinição de senha enviados pelo Supabase (ex.: FRONTEND_URL/auth/callback).
# Precisa estar cadastrada como Redirect URL no Dashboard do Supabase.
FRONTEND_URL=http://localhost:3000

# Opcional: caminho para o CA bundle de um proxy corporativo de inspeção TLS.
# Deixe vazio na maioria dos casos — a verificação TLS padrão já funciona.
# Defina apenas se o ambiente estiver atrás de um proxy que intercepta HTTPS
# e as chamadas a Supabase/OpenAI falharem por erro de certificado.
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# Limites do OCR por página (Vision), que tem custo de ~US$ 0,002-0,01 por página.
# Documento acima do teto falha explicitamente em vez de ser processado parcialmente.
OCR_MAX_PAGES=40
OCR_PAGE_TIMEOUT_SECONDS=60

# Limiares de detecção de extração de PDF incompleta. Calibrados contra o acervo
# real: documentos íntegros ficam em 216-394 palavras/página e 0,5-2,3% de números
# isolados; um documento com extração quebrada ficou em 51 palavras e 8,2%.
EXTRACTION_MIN_WORDS_PER_PAGE=120
EXTRACTION_MAX_ISOLATED_NUMBER_RATIO=0.05
EXTRACTION_MAX_SPARSE_PAGE_RATIO=0.5

# Modelo de embedding e dimensão, explícitos (nunca depender do default
# implícito da biblioteca — foi exatamente isso que fez o modelo cair
# silenciosamente para o ada-002, pior e mais caro, por meses).
# text-embedding-3-large truncado em 1536 dims cabe no schema vector(1536)
# e no índice HNSW existentes, sem precisar migrar coluna nem índice, e
# ainda assim supera ada-002 e o 3-small na mesma dimensionalidade.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Tamanho e sobreposição de chunk. Restaura a ordem de grandeza da versão
# que funcionava — chunks de 4000 caracteres diluíam o sinal do embedding e
# degradavam a precisão da busca por similaridade. Testado contra a linha de
# base do harness (backend/evaluation/): 1200 e 1600 foram comparados; 1600
# tem menor regressão de recall com k=20 (0.842 vs 0.895 da base). Ver
# RETRIEVAL_K abaixo — é o que fecha essa lacuna. Ver design.md da change
# `restore-embedding-and-chunking-quality` para os números completos.
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Quantidade de candidatos pedidos ao RPC de busca vetorial. 40 restaura por
# completo o recall perdido pelo chunking mais granular (medido: 0.895,
# empate exato com a linha de base pré-mudança de embedding). Ver design.md
# da change `retrieval-refusal-quality`.
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=40

# Limiar de confiança alta e piso de recusa, calibrados contra a distribuição
# real de similaridade do golden set (backend/evaluation/) com
# text-embedding-3-large: perguntas fora do escopo pontuaram 0.512-0.629, a
# pergunta respondível mais fraca pontuou 0.539. Não existe um único valor
# que separe os dois grupos com perfeição — os valores abaixo priorizam não
# recusar perguntas respondíveis, aceitando que algumas perguntas fora do
# escopo caiam na "zona fraca" (respondidas com ressalva, não recusadas).
# Ver design.md da change `retrieval-refusal-quality` para os números completos.
PRIMARY_RPC_SIMILARITY_THRESHOLD=0.65
REFUSAL_FLOOR_SIMILARITY=0.53
